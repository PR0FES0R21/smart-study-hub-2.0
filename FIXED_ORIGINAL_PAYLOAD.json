{
  "config": {
    "main_collection": "users",
    "fields": ["email", "username"],
    "filters": [
      {
        "field": "roles",
        "operator": "eq",
        "value": "student"
      }
    ],
    "joins": [
      {
        "collection": "profiles",
        "local_field": "profile_id",
        "foreign_field": "_id",
        "alias": "profile",
        "join_type": "lookup",
        "fields": ["full_name", "gender", "class_id", "department_id"],
        "preserve_null_and_empty_arrays": false,
        "joins": [
          {
            "collection": "classes",
            "local_field": "class_id",
            "foreign_field": "_id",
            "alias": "class_detail",
            "join_type": "lookup",
            "fields": ["name", "grade_level"],
            "preserve_null_and_empty_arrays": true
          },
          {
            "collection": "expertise_programs",
            "local_field": "department_id",
            "foreign_field": "_id",
            "alias": "expertise",
            "join_type": "lookup",
            "fields": ["name", "abbreviation"],
            "preserve_null_and_empty_arrays": true
          }
        ]
      }
    ],
    "limit": 10
  },
  "format": "excel",
  "filename": "students_with_nested_joins"
}

# Smart Study Hub 2.0 - Environment Configuration Template
# Copy this file to .env and update the values according to your setup

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME="Smart Study Hub 2.0"
APP_VERSION="1.0.0-MVP"
DEBUG=False
SECRET_KEY="your-super-secret-key-change-this-in-production"
API_V1_STR="/api/v1"

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# MongoDB Connection
MONGODB_URL="mongodb://localhost:27017/smart_study_hub"
DATABASE_NAME="smart_study_hub"

# For production with authentication:
# MONGODB_URL="mongodb://username:password@localhost:27017/smart_study_hub"

# For MongoDB Atlas:
# MONGODB_URL="mongodb+srv://username:password@cluster.mongodb.net/smart_study_hub?retryWrites=true&w=majority"

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Redis Connection
REDIS_URL="redis://localhost:6379/0"

# For production with password:
# REDIS_URL="redis://:password@localhost:6379/0"

# For Redis Cloud:
# REDIS_URL="redis://:password@redis-host:port/0"

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM="HS256"

# Password Security
MIN_PASSWORD_LENGTH=8
MAX_PASSWORD_LENGTH=128

# Session Configuration
SESSION_EXPIRE_HOURS=24
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# =============================================================================
# FILE UPLOAD SETTINGS
# =============================================================================
# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_EXTENSIONS=".jpg,.jpeg,.png,.gif,.pdf,.doc,.docx,.xls,.xlsx"
UPLOAD_DIR="./uploads"

# Export Settings
EXPORT_MAX_RECORDS=50000
EXPORT_TIMEOUT_SECONDS=300

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================
# SMTP Settings for email notifications
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST="smtp.gmail.com"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAILS_FROM_EMAIL="noreply@smartstudyhub.com"
EMAILS_FROM_NAME="Smart Study Hub"

# Email Templates
EMAIL_RESET_TOKEN_EXPIRE_HOURS=48
EMAIL_TEMPLATES_DIR="./app/email-templates"

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Logging Settings
LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE="./logs/app.log"
LOG_MAX_SIZE=10485760  # 10MB
LOG_BACKUP_COUNT=5

# Audit Logging
AUDIT_LOG_ENABLED=True
AUDIT_LOG_FILE="./logs/audit.log"

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
# Server Configuration
WORKERS=4
MAX_CONNECTIONS=100
KEEPALIVE=2
TIMEOUT=30

# Cache Settings
CACHE_TTL_SECONDS=3600  # 1 hour
CACHE_MAX_KEYS=10000

# Database Connection Pool
DB_MIN_CONNECTIONS=10
DB_MAX_CONNECTIONS=100

# =============================================================================
# CORS SETTINGS
# =============================================================================
# CORS Configuration for frontend
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# For production, add your frontend domains:
# BACKEND_CORS_ORIGINS=["https://yourdomain.com", "https://www.yourdomain.com"]

# =============================================================================
# WEBSOCKET SETTINGS
# =============================================================================
# WebSocket Configuration
WEBSOCKET_ENABLED=True
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_MAX_CONNECTIONS=1000

# =============================================================================
# ANALYTICS SETTINGS
# =============================================================================
# Analytics Configuration
ANALYTICS_ENABLED=True
ANALYTICS_BATCH_SIZE=1000
ANALYTICS_PROCESSING_INTERVAL=300  # 5 minutes

# Performance Monitoring
PERFORMANCE_MONITORING=True
SLOW_QUERY_THRESHOLD=1000  # milliseconds

# =============================================================================
# EXAM SYSTEM SETTINGS
# =============================================================================
# Exam Configuration
EXAM_MAX_DURATION_MINUTES=180  # 3 hours
EXAM_AUTO_SUBMIT_BUFFER_SECONDS=30
EXAM_TAB_SWITCH_LIMIT=3

# Anti-cheating Settings
CHEATING_DETECTION_ENABLED=True
SCREENSHOT_ON_TAB_SWITCH=False
WEBCAM_MONITORING=False

# =============================================================================
# BACKUP SETTINGS
# =============================================================================
# Backup Configuration
BACKUP_ENABLED=True
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_DIRECTORY="./backups"

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Development Only Settings (set to False in production)
RELOAD_ON_CHANGE=False
SHOW_DOCS=True
ENABLE_PROFILER=False

# Testing
TEST_DATABASE_NAME="test_smart_study_hub"
TEST_REDIS_DB=1

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================
# Production Security
SECURE_COOKIES=True
HTTPS_ONLY=True
HSTS_MAX_AGE=31536000  # 1 year

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60  # seconds

# Health Check
HEALTH_CHECK_ENABLED=True
HEALTH_CHECK_INTERVAL=30  # seconds

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
# Monitoring Settings
MONITORING_ENABLED=True
METRICS_ENDPOINT_ENABLED=True

# External Monitoring (Optional)
# SENTRY_DSN="your-sentry-dsn"
# NEW_RELIC_LICENSE_KEY="your-newrelic-key"

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Feature Toggles
FEATURE_ADVANCED_ANALYTICS=True
FEATURE_EXPORT_SYSTEM=True
FEATURE_WEBSOCKET=True
FEATURE_EMAIL_NOTIFICATIONS=True
FEATURE_AUDIT_LOGGING=True

# Experimental Features
EXPERIMENTAL_AI_FEATURES=False
EXPERIMENTAL_MOBILE_API=False

{
  "config": {
    "main_collection": "users",
    "fields": ["email", "login_id"],
    "filters": [
      {
        "field": "roles",
        "operator": "eq", 
        "value": "student"
      }
    ],
    "joins": [
      {
        "collection": "profiles",
        "local_field": "profile_id",
        "foreign_field": "_id",
        "alias": "profile",
        "join_type": "lookup",
        "fields": ["full_name", "gender"],
        "preserve_null_and_empty_arrays": false,
        "joins": [
          {
            "collection": "classes",
            "local_field": "class_id",
            "foreign_field": "_id", 
            "alias": "class_detail",
            "join_type": "lookup",
            "fields": ["name", "grade_level"],
            "preserve_null_and_empty_arrays": true,
            "joins": [
               {
            "collection": "expertise_programs",
            "local_field": "expertise_id",
            "foreign_field": "_id",
            "alias": "expertise", 
            "join_type": "lookup",
            "fields": ["name", "abbreviation"],
            "preserve_null_and_empty_arrays": true
          }
            ]
          }
        ]
      }
    ],
    "limit": 10
  },
  "format": "excel",
  "filename": "students_with_computed_fields",
  "formatting": {
    "exclude_ids": true,
    "use_aliases": true,
    "flatten_nested": true,
    "include_empty_fields": false,
    "computed_fields": [
      {
        "name": "class_full_name",
        "alias": "Nama Kelas Lengkap",
        "template": "{grade_level} {abbreviation} {class_name}",
        "fields": [
          "profile.class_detail.grade_level",
          "profile.class_detail.expertise.abbreviation",
          "profile.class_detail.name"
        ]
      },
      {
        "name": "student_identity",
        "alias": "Identitas Siswa",
        "template": "{nis} - {full_name}",
        "fields": [
          "login_id",
          "profile.full_name"
        ]
      }
    ]
  }
}

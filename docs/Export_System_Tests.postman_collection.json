				{
					"name": "Exam Results Export",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"config\": {\n    \"main_collection\": \"exam_sessions\",\n    \"fields\": [\"score\", \"status\", \"started_at\", \"submitted_at\"],\n    \"filters\": [\n      {\n        \"field\": \"status\",\n        \"operator\": \"eq\",\n        \"value\": \"graded\"\n      }\n    ],\n    \"joins\": [\n      {\n        \"collection\": \"users\",\n        \"local_field\": \"student_id\",\n        \"foreign_field\": \"_id\",\n        \"fields\": [\"username\"],\n        \"join_type\": \"unwind\"\n      },\n      {\n        \"collection\": \"profiles\",\n        \"local_field\": \"users.profile_id\",\n        \"foreign_field\": \"_id\",\n        \"fields\": [\"full_name\"],\n        \"join_type\": \"unwind\"\n      },\n      {\n        \"collection\": \"exams\",\n        \"local_field\": \"exam_id\",\n        \"foreign_field\": \"_id\",\n        \"fields\": [\"title\", \"exam_type\"],\n        \"join_type\": \"unwind\"\n      }\n    ],\n    \"sort\": {\"score\": -1},\n    \"limit\": 50\n  },\n  \"format\": \"excel\",\n  \"filename\": \"exam_results_test\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/exports/execute",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "exports", "execute"]
						}
					}
				},
				{
					"name": "Advanced Filtering Example",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}",
								"type": "text"

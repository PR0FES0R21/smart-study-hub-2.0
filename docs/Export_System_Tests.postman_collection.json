		{
			"name": "Validation",
			"item": [
				{
					"name": "Validate Basic Config",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"config\": {\n    \"main_collection\": \"users\",\n    \"fields\": [\"username\", \"email\", \"is_active\"],\n    \"filters\": [\n      {\n        \"field\": \"roles\",\n        \"operator\": \"eq\",\n        \"value\": \"student\"\n      }\n    ],\n    \"limit\": 100\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/exports/validate",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "exports", "validate"]
						}
					}
				},
				{
					"name": "Validate Complex Config with Joins",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"config\": {\n    \"main_collection\": \"users\",\n    \"fields\": [\"username\", \"email\"],\n    \"filters\": [\n      {\n        \"field\": \"roles\",\n        \"operator\": \"eq\",\n        \"value\": \"student\"\n      }\n    ],\n    \"joins\": [\n      {\n        \"collection\": \"profiles\",\n        \"local_field\": \"profile_id\",\n        \"foreign_field\": \"_id\",\n        \"fields\": [\"full_name\", \"birth_date\", \"gender\"],\n        \"join_type\": \"unwind\"\n      },\n      {\n        \"collection\": \"classes\",\n        \"local_field\": \"profiles.class_id\",\n        \"foreign_field\": \"_id\",\n        \"fields\": [\"name\", \"grade_level\"],\n        \"join_type\": \"unwind\"\n      }\n    ],\n    \"sort\": {\"profiles.full_name\": 1},\n    \"limit\": 200\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/exports/validate",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "exports", "validate"]
						}
					}
				}
			]
		},
		{
			"name": "Export Execution",
			"item": [
				{
					"name": "Simple Student Export (JSON)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"config\": {\n    \"main_collection\": \"users\",\n    \"fields\": [\"username\", \"email\", \"is_active\", \"created_at\"],\n    \"filters\": [\n      {\n        \"field\": \"roles\",\n        \"operator\": \"eq\",\n        \"value\": \"student\"\n      }\n    ],\n    \"limit\": 10\n  },\n  \"format\": \"json\",\n  \"filename\": \"simple_students_test\",\n  \"async_export\": false\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/exports/execute",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "exports", "execute"]
						}
					}
				},
				{
					"name": "Student Export with Profile Data (Excel)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"config\": {\n    \"main_collection\": \"users\",\n    \"fields\": [\"username\", \"email\", \"is_active\"],\n    \"filters\": [\n      {\n        \"field\": \"roles\",\n        \"operator\": \"eq\",\n        \"value\": \"student\"\n      }\n    ],\n    \"joins\": [\n      {\n        \"collection\": \"profiles\",\n        \"local_field\": \"profile_id\",\n        \"foreign_field\": \"_id\",\n        \"fields\": [\"full_name\", \"birth_date\", \"gender\", \"class_id\"],\n        \"join_type\": \"unwind\"\n      },\n      {\n        \"collection\": \"classes\",\n        \"local_field\": \"profiles.class_id\",\n        \"foreign_field\": \"_id\",\n        \"fields\": [\"name\", \"grade_level\"],\n        \"join_type\": \"unwind\"\n      }\n    ],\n    \"sort\": {\"profiles.full_name\": 1},\n    \"limit\": 25\n  },\n  \"format\": \"excel\",\n  \"filename\": \"students_with_profile_test\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/exports/execute",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "exports", "execute"]
						}
					}
				},
				{
					"name": "Teacher Data Export (CSV)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}

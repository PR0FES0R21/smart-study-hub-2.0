							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"config\": {\n    \"main_collection\": \"users\",\n    \"fields\": [\"username\", \"email\", \"created_at\"],\n    \"filters\": [\n      {\n        \"field\": \"roles\",\n        \"operator\": \"eq\",\n        \"value\": \"student\"\n      },\n      {\n        \"field\": \"is_active\",\n        \"operator\": \"eq\",\n        \"value\": true\n      },\n      {\n        \"field\": \"created_at\",\n        \"operator\": \"gte\",\n        \"value\": \"2024-01-01\"\n      }\n    ],\n    \"joins\": [\n      {\n        \"collection\": \"profiles\",\n        \"local_field\": \"profile_id\",\n        \"foreign_field\": \"_id\",\n        \"fields\": [\"full_name\", \"class_id\"],\n        \"join_type\": \"unwind\"\n      },\n      {\n        \"collection\": \"classes\",\n        \"local_field\": \"profiles.class_id\",\n        \"foreign_field\": \"_id\",\n        \"fields\": [\"name\", \"grade_level\"],\n        \"join_type\": \"unwind\",\n        \"filters\": [\n          {\n            \"field\": \"grade_level\",\n            \"operator\": \"in\",\n            \"value\": [10, 11, 12]\n          }\n        ]\n      }\n    ],\n    \"sort\": {\"created_at\": -1},\n    \"limit\": 100\n  },\n  \"format\": \"excel\",\n  \"filename\": \"filtered_students_advanced\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/exports/execute",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "exports", "execute"]
						}
					}

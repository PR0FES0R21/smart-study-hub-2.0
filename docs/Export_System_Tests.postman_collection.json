						"body": {
							"mode": "raw",
							"raw": "{\n  \"config\": {\n    \"main_collection\": \"users\",\n    \"fields\": [\"username\", \"email\", \"is_active\"],\n    \"filters\": [\n      {\n        \"field\": \"roles\",\n        \"operator\": \"eq\",\n        \"value\": \"teacher\"\n      }\n    ],\n    \"joins\": [\n      {\n        \"collection\": \"profiles\",\n        \"local_field\": \"profile_id\",\n        \"foreign_field\": \"_id\",\n        \"fields\": [\"full_name\"],\n        \"join_type\": \"unwind\"\n      }\n    ],\n    \"sort\": {\"profiles.full_name\": 1},\n    \"limit\": 15\n  },\n  \"format\": \"csv\",\n  \"filename\": \"teachers_test\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/exports/execute",
